# --- deps / build ---
node_modules/
dist/
build/
.svelte-kit/
*.tsbuildinfo

# --- local data (sqlite transcript store; docs/design §7.5) ---
*.db
*.db-wal
*.db-shm
data/

# --- secrets (NEVER commit) ---
# Local dev reads .env directly; Doppler injects in prod. Only .env.example is tracked.
.env
.env.*
!.env.example
.doppler/

# --- bun ---
# NOTE: bun.lockb (or bun.lock) MUST be committed — installs stay reproducible
# and the Docker builds run `bun install --frozen-lockfile`.
# It is intentionally NOT ignored here. (See docs/getting-started.md, Step 1.)

# --- cerebe (Cerebe Factory gate) ---
# Review artifacts and other CLI runtime output live under cerebe/ and are
# ignored by cerebe/.gitignore. cerebe/config.json and cerebe.yaml are committed.
# The per-developer overlay files are ignored at the end of this file.

# --- editor / OS ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Cerebe per-dev overlay (restrict-only; leftover darkfactory.* still ignored)
cerebe.local.yaml
cerebe.local.yml
darkfactory.local.yaml
darkfactory.local.yml
